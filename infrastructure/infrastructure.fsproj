<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <Content Include="Pulumi.main.yaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" Version="10.1.400" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Pulumi.Aws" Version="7.44.0" />
    <PackageReference Include="Pulumi.FSharp" Version="3.113.0" />
    <PackageReference Include="Thoth.Json.System.Text.Json" Version="0.4.0" />
    <!-- Pulumi still asks for OpenTelemetry 1.9.0, which has two advisories against it
         (GHSA-g94r-2vxg-569j, GHSA-4625-4j76-fww9). Both are fixed in 1.15.3. -->
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
  </ItemGroup>
</Project>