<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    </packageSources>
    <!-- Without this, FSharp.Core can be restored either from nuget.org or from the SDK's own
         `FSharp/library-packs` folder. Those are different files for the same version (the SDK
         copy is not repository-signed), so they hash differently and whichever one wins ends up
         baked into packages.lock.json, giving NU1403 on any machine that picks the other.
         Mapping every package to nuget.org keeps restores reproducible. -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
    </packageSourceMapping>
</configuration>
